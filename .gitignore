# --- Virtual Environments ---
venv/
env/
.venv/
env.bak/
venv.bak/

# --- Secrets & Config (CRITICAL) ---
.env
*.env
secrets.json

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.ipynb_checkpoints/

# --- Databases (Local Storage) ---
*.db
*.sqlite
hiresync_local.db
hiresync_enterprise.db

# --- Media Files (Privacy & Storage) ---
# We ignore these because they contain candidate recordings and take up too much space
*.wav
*.mp4
*.webm
*.mov
audio_extract_*.wav
v_audio_*.wav
temp_*.wav
processed_*.mp4
rescue_audio_*.wav

# --- AI Models & Large Assets ---
# These are usually too large for Git and should be downloaded separately
face_landmarker.task
*.task
*.onnx
*.pb

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Gradio & App Temp Files ---
gradio_cached/
flagged/
*.log
output.log

# --- Executables & Installers ---
*.exe
*.dll
*.msi